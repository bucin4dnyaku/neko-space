<style>
:root {
    --bg: #100b20;
    --panel: #211531;
    --pink: #ed91d2;
    --magenta: #c44ba4;
    --purple: #b39ddb;
    --border: #78549c;
    --text: #e5d8ef;
    --muted: #b49bc8;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background-color: var(--bg);
    background-image:
        radial-gradient(#c8b1ef 1px, transparent 1px),
        radial-gradient(#d56bb8 1px, transparent 1px),
        radial-gradient(#ffffff 1px, transparent 1px);
    background-size: 53px 53px, 97px 97px, 137px 137px;
    background-position: 0 0, 30px 17px, 65px 35px;
    color: var(--text);
    font-family: Verdana, Tahoma, sans-serif;
    font-size: 13px;
    line-height: 1.8;
}

a {
    color: var(--pink);
    text-decoration: none;
}

a:hover {
    color: white;
    text-decoration: underline;
}

.site {
    max-width: 1150px;
    margin: 30px auto;
    padding: 12px;
    background: #170f27;
    border: 2px solid var(--border);
    box-shadow: 5px 5px #39234f;
}

/* SYSTEM BAR */

.system-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 5px;
    background: #36204e;
    padding: 8px 12px;
    font-size: 11px;
    color: var(--purple);
    border: 1px solid var(--border);
}

.online {
    color: #9fe8bf;
}

/* HEADER */

header {
    position: relative;
    overflow: hidden;
    background: linear-gradient(
        135deg,
        #211334,
        #4c2158,
        #27163c
    );
    padding: 45px 15px;
    text-align: center;
    border: 1px solid var(--border);
    margin-top: 10px;
}

header h1 {
    color: #f5b9e8;
    font-family: Georgia, serif;
    font-size: clamp(30px, 6vw, 55px);
    margin: 10px 0;
    text-shadow: 3px 3px #613b80;
}

header p {
    color: #d6bde9;
    margin: 5px;
}

.stars {
    color: #f0a0dc;
    letter-spacing: 9px;
    animation: twinkle 3s infinite;
}

@keyframes twinkle {
    0%, 100% { opacity: 1; }
    50% { opacity: .45; }
}

/* NAVIGATION */

nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 12px;
    margin: 10px 0;
    background: #261735;
    border: 1px solid var(--border);
}

nav a {
    padding: 7px 15px;
    background: #39234e;
    border: 1px solid #9670ba;
    color: #f3c0e7;
    font-size: 12px;
    box-shadow: 2px 2px #140d20;
}

nav a:hover {
    background: #633778;
    text-decoration: none;
}

/* LAYOUT */

.layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) 230px;
    gap: 12px;
    align-items: start;
}

.panel {
    background: var(--panel);
    border: 1px solid var(--border);
    margin-bottom: 12px;
    box-shadow: 3px 3px #100b20;
}

.panel-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    background: linear-gradient(
        90deg,
        #684081,
        #472952
    );
    border-bottom: 1px solid var(--border);
    color: #ffe0f4;
    font-size: 12px;
    font-weight: bold;
}

.panel-body {
    padding: 15px;
}

.center {
    text-align: center;
}

.small {
    color: var(--muted);
    font-size: 11px;
}

/* NEKO ASTRONAUT */

.astronaut {
    width: 145px;
    max-width: 100%;
    height: auto;
    margin: auto;
    display: block;
    animation: float 4s ease-in-out infinite;
}

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-9px); }
}

.mascot {
    padding: 15px 5px;
    background: #171024;
    border: 1px dashed #78549c;
}

.mood {
    margin-top: 12px;
    padding: 7px;
    background: #20392f;
    border: 1px solid #4e8069;
    color: #a6e7c3;
    font-size: 10px;
}

/* HERO */

.hero {
    background: linear-gradient(
        135deg,
        #2b1a40,
        #46254e
    );
    border: 1px dashed #9164ad;
    padding: 25px 15px;
    text-align: center;
}

.hero h2 {
    font-family: Georgia, serif;
    font-size: 27px;
    color: #f4b6e7;
    margin: 8px 0;
}

.kaomoji {
    font-size: 22px;
    color: var(--pink);
}

.space-art {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #78549c;
    margin: 15px 0;
}

/* SIDEBAR */

.menu {
    list-style: none;
    margin: 0;
    padding: 0;
}

.menu li {
    padding: 7px 0;
    border-bottom: 1px dashed #523966;
}

.menu li:last-child {
    border: none;
}

/* BLOGROLL */

.blogroll {
    list-style: none;
    padding: 0;
    margin: 0;
}

.blogroll li {
    margin-bottom: 10px;
}

.blogroll a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 5px;
    padding: 10px;
    background: #39234c;
    border: 1px solid #8d60ac;
    color: #f5bce9;
    font-size: 11px;
    font-weight: bold;
    transition: .2s ease;
}

.blogroll a:hover {
    background: #62316e;
    border-color: #ed91d2;
    transform: translateX(3px);
    text-decoration: none;
}

/* JOURNAL */

article {
    padding: 15px 0;
    border-bottom: 1px dashed #65467b;
}

article:last-child {
    border: none;
}

article h3 {
    color: #edb1e4;
    font-family: Georgia, serif;
    font-size: 21px;
    line-height: 1.4;
    margin: 5px 0;
}

article p {
    margin: 10px 0;
}

article time {
    font-size: 11px;
    color: var(--muted);
}

.tag {
    display: inline-block;
    padding: 2px 8px;
    background: #482c5f;
    border: 1px solid #79529d;
    color: #e0c5f6;
    font-size: 10px;
}

/* STAMPS */

.stamps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
}

.stamp {
    width: 88px;
    height: 31px;
    display: grid;
    place-items: center;
    text-align: center;
    background: #432857;
    border: 2px outset #966db1;
    color: #efc9f5;
    font-size: 9px;
    font-weight: bold;
    line-height: 1.2;
}

.stamp.pink {
    background: #6d365f;
    color: #ffd4ed;
}

.stamp.green {
    background: #294b40;
    color: #ace6c8;
}

.notice {
    background: #2e1c43;
    border: 1px dashed #8c61ad;
    padding: 12px;
    font-size: 12px;
}

/* STATUS */

.progress {
    height: 10px;
    background: #100b20;
    border: 1px solid #78549c;
    margin: 7px 0 12px;
}

.progress span {
    display: block;
    height: 100%;
    background: linear-gradient(
        90deg,
        #8761b7,
        #ed91d2
    );
}

footer {
    padding: 20px 10px;
    background: #2f1c43;
    border: 1px solid var(--border);
    text-align: center;
    font-size: 11px;
}

footer p {
    margin: 5px;
}

/* MOBILE */

@media (max-width: 900px) {
    .layout {
        grid-template-columns: 175px minmax(0, 1fr);
    }

    .right {
        grid-column: 1 / -1;
    }
}

@media (max-width: 600px) {
    .site {
        margin: 8px;
        padding: 7px;
    }

    .layout {
        grid-template-columns: 1fr;
    }

    .right {
        grid-column: auto;
    }

    main {
        order: -1;
    }

    header {
        padding: 25px 12px;
    }

    nav a {
        padding: 5px 9px;
        font-size: 11px;
    }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation: none !important;
        transition: none !important;
        scroll-behavior: auto !important;
    }
}
</style>
